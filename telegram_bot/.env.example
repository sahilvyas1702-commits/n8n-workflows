# Telegram Bot Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub - add to .gitignore

# 1. Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# 2. Get your Telegram User ID from @userinfobot
YOUR_TELEGRAM_USER_ID=YOUR_USER_ID_HERE

# 3. n8n Webhook URL (for workflow generation)
# Local: http://localhost:5678/webhook/workflow-generator
# Remote: https://your-n8n-instance.com/webhook/workflow-generator
N8N_WEBHOOK_URL=http://localhost:5678/webhook/workflow-generator

# 4. GitHub Token (for committing workflows)
# Create at: https://github.com/settings/tokens
# Scopes: repo (full control of private repositories)
GITHUB_TOKEN=ghp_YOUR_GITHUB_TOKEN_HERE

# 5. GitHub Repo Details
GITHUB_OWNER=sahilvyas1702-commits
GITHUB_REPO=n8n-workflows

# 6. Optional: Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 7. Optional: Bot Settings
BOT_TIMEOUT=30
MAX_PROMPT_LENGTH=2000
MIN_PROMPT_LENGTH=20

# 8. Optional: Database (for storing workflow history)
# DATABASE_URL=postgresql://user:password@localhost/workflow_db
# Or leave empty to use file-based storage

# 9. Optional: Slack Webhook (for bot notifications)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
